from numpy.typing import NDArray
import numpy as np

class Audio:
    def log_normalize(self, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def normalize_with_minmax(self, input: NDArray[np.floating], min_val: float, max_val: float) -> NDArray[np.floating]: ...
    def fused_vad_features(self, spectrogram: NDArray[np.floating], lower_freq_idx: int, upper_freq_idx: int, width: int, height: int) -> NDArray[np.floating]: ...
    def smooth_1d(self, input: NDArray[np.floating], window_size: int) -> NDArray[np.floating]: ...
    def log_normalize_res(self, input: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def normalize_with_minmax_res(self, input: NDArray[np.floating], min_val: float, max_val: float, output: NDArray[np.floating]) -> None: ...
    def fused_vad_features_res(self, spectrogram: NDArray[np.floating], lower_freq_idx: int, upper_freq_idx: int, width: int, height: int, features: NDArray[np.floating]) -> None: ...
    def smooth_1d_res(self, input: NDArray[np.floating], window_size: int, output: NDArray[np.floating]) -> None: ...
