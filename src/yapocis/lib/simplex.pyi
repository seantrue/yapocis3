from numpy.typing import NDArray
import numpy as np

class Simplex:
    def simplex2d(self, seed: int, scale: float, offset_x: float, offset_y: float, octaves: int, persistence: float, lacunarity: float, tileable: int) -> NDArray[np.floating]: ...
    def simplex3d(self, width: int, height: int, depth: int, seed: int, scale: float, offset_x: float, offset_y: float, offset_z: float, octaves: int, persistence: float, lacunarity: float) -> NDArray[np.floating]: ...
    def simplex2d_res2d(self, output: NDArray[np.floating], seed: int, scale: float, offset_x: float, offset_y: float, octaves: int, persistence: float, lacunarity: float, tileable: int) -> None: ...
    def simplex3d_res3d(self, width: int, height: int, depth: int, output: NDArray[np.floating], seed: int, scale: float, offset_x: float, offset_y: float, offset_z: float, octaves: int, persistence: float, lacunarity: float) -> None: ...
