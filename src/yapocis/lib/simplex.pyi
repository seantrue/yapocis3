from typing import Any
from numpy.typing import NDArray
import numpy as np

class Simplex:
    def __init__(self, device_name: Any = ..., backend: Any = ..., use_async: Any = ..., async_write: Any = ..., **kwargs: Any) -> None: ...
    def write(self, a: Any, wait: Any = ...) -> Any: ...
    def read(self, a: Any) -> Any: ...
    def snapshot(self, **kwargs: Any) -> Any: ...
    def purge(self) -> Any: ...
    def simplex2d(self, width: Any, height: Any, seed: Any = ..., scale: Any = ..., offset: Any = ..., octaves: Any = ..., persistence: Any = ..., lacunarity: Any = ..., tileable: Any = ...) -> Any: ...
    def simplex3d(self, width: Any, height: Any, depth: Any, seed: Any = ..., scale: Any = ..., offset: Any = ..., octaves: Any = ..., persistence: Any = ..., lacunarity: Any = ...) -> Any: ...
    def turbulence(self, width: Any, height: Any, seed: Any = ..., scale: Any = ..., octaves: Any = ...) -> Any: ...
    def ridged(self, width: Any, height: Any, seed: Any = ..., scale: Any = ..., octaves: Any = ...) -> Any: ...
    def simplex2d_res2d(self, output: NDArray[np.floating], seed: int, scale: float, offset_x: float, offset_y: float, octaves: int, persistence: float, lacunarity: float, tileable: int) -> None: ...
    def simplex3d_res3d(self, width: int, height: int, depth: int, output: NDArray[np.floating], seed: int, scale: float, offset_x: float, offset_y: float, offset_z: float, octaves: int, persistence: float, lacunarity: float) -> None: ...
