    def filterImage3_res(self, input: NDArray[np.floating], scale: float, size_step: float, output: NDArray[np.floating]) -> None: ...
    def filterImage4_res(self, input: NDArray[np.floating], scale: float, size_step: float, output: NDArray[np.floating]) -> None: ...
