from numpy.typing import NDArray
import numpy as np

class Zcs:
    def zcs1(self, threshold: float, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def zcs2(self, threshold: float, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def zcs3(self, threshold: float, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def zcs4(self, threshold: float, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def sub(self, input1: NDArray[np.floating], input2: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def zcs1_res(self, threshold: float, input: NDArray[np.floating], zcs: NDArray[np.floating]) -> None: ...
    def zcs2_res(self, threshold: float, input: NDArray[np.floating], zcs: NDArray[np.floating]) -> None: ...
    def zcs3_res(self, threshold: float, input: NDArray[np.floating], zcs: NDArray[np.floating]) -> None: ...
    def zcs4_res(self, threshold: float, input: NDArray[np.floating], zcs: NDArray[np.floating]) -> None: ...
    def sub_res(self, input1: NDArray[np.floating], input2: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
