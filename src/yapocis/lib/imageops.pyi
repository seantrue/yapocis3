from typing import Any
from numpy.typing import NDArray
import numpy as np

class Imageops:
    def __init__(self, device_name: Any = ..., backend: Any = ..., use_async: Any = ..., async_write: Any = ..., **kwargs: Any) -> None: ...
    def write(self, a: Any, wait: Any = ...) -> Any: ...
    def read(self, a: Any) -> Any: ...
