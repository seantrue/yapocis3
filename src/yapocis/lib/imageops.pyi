    def purge(self) -> Any: ...
    def clamp_pixels(self, input: Any, low: Any = ..., high: Any = ...) -> Any: ...
    def stretch(self, input: Any, input_min: Any, input_max: Any, low: Any = ..., high: Any = ...) -> Any: ...
    def binarize(self, input: Any, threshold: Any = ...) -> Any: ...
    def histogram(self, input: Any, n_bins: Any = ..., n_workers: Any = ..., low: Any = ..., high: Any = ...) -> Any: ...
    def histogram_res(self, input: Any, hst: Any, low: Any = ..., high: Any = ...) -> Any: ...
