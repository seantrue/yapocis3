from numpy.typing import NDArray
import numpy as np

class Imageops:
    def clamp_pixels(self, input: NDArray[np.floating], low: float, high: float) -> NDArray[np.floating]: ...
    def stretch(self, input: NDArray[np.floating], input_min: float, input_max: float, low: float, high: float) -> NDArray[np.floating]: ...
    def binarize(self, input: NDArray[np.floating], threshold: float) -> NDArray[np.floating]: ...
    def histogram(self, input: NDArray[np.floating], low: float, high: float) -> NDArray[np.signedinteger]: ...
    def histogram_res(self, input: NDArray[np.floating], low: float, high: float, hst: NDArray[np.signedinteger]) -> None: ...
