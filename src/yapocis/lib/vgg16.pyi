    def conv2d_3x3_optimized(self, input: NDArray[np.floating], weights: NDArray[np.floating], bias: NDArray[np.floating], output_channels: int) -> NDArray[np.floating]: ...
    def relu_activation(self, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def softmax(self, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def max_pool_2x2(self, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def batch_norm(self, input: NDArray[np.floating], gamma: NDArray[np.floating], beta: NDArray[np.floating], mean: NDArray[np.floating], variance: NDArray[np.floating], epsilon: float) -> NDArray[np.floating]: ...
    def fully_connected(self, input: NDArray[np.floating], weights: NDArray[np.floating], bias: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def matrix_multiply_simd(self, A: NDArray[np.floating], B: NDArray[np.floating], bias: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def conv2d_3x3_res(self, input: NDArray[np.floating], weights: NDArray[np.floating], bias: NDArray[np.floating], output: NDArray[np.floating], output_channels: int) -> None: ...
