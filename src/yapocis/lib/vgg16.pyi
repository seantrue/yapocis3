    def softmax_res(self, input: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def max_pool_2x2_res(self, input: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def batch_norm_res(self, input: NDArray[np.floating], gamma: NDArray[np.floating], beta: NDArray[np.floating], mean: NDArray[np.floating], variance: NDArray[np.floating], output: NDArray[np.floating], epsilon: float) -> None: ...
    def fully_connected_res(self, input: NDArray[np.floating], weights: NDArray[np.floating], bias: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def matrix_multiply_simd_res(self, A: NDArray[np.floating], B: NDArray[np.floating], bias: NDArray[np.floating], C: NDArray[np.floating]) -> None: ...
