from typing import Any
from numpy.typing import NDArray
import numpy as np

class Colormath:
    def __init__(self, device_name: Any = ..., backend: Any = ..., use_async: Any = ..., async_write: Any = ..., **kwargs: Any) -> None: ...
    def write(self, a: Any, wait: Any = ...) -> Any: ...
    def read(self, a: Any) -> Any: ...
    def snapshot(self, **kwargs: Any) -> Any: ...
    def purge(self) -> Any: ...
    def transform_named(self, name: Any, array: Any) -> Any: ...
    def xyz2xyY(self, input: Any) -> Any: ...
    def xyY2xyz(self, input: Any) -> Any: ...
    def transform(self, input: NDArray[np.floating], transform_id: int) -> NDArray[np.floating]: ...
    def transform_res(self, input: NDArray[np.floating], transform_id: int, output: NDArray[np.floating]) -> None: ...
    def xyz2xyY_res(self, input: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def xyY2xyz_res(self, input: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
