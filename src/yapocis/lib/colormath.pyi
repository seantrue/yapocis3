from numpy.typing import NDArray
import numpy as np

class Colormath:
    def transform(self, input: NDArray[np.floating], transform_id: int) -> NDArray[np.floating]: ...
    def xyz2xyY(self, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def xyY2xyz(self, input: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def transform_res(self, input: NDArray[np.floating], transform_id: int, output: NDArray[np.floating]) -> None: ...
    def xyz2xyY_res(self, input: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def xyY2xyz_res(self, input: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
