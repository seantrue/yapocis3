from typing import Any
from numpy.typing import NDArray
import numpy as np

class Gradient:
    def __init__(self, device_name: Any = ..., backend: Any = ..., use_async: Any = ..., async_write: Any = ..., **kwargs: Any) -> None: ...
    def write(self, a: Any, wait: Any = ...) -> Any: ...
    def read(self, a: Any) -> Any: ...
    def snapshot(self, **kwargs: Any) -> Any: ...
    def purge(self) -> Any: ...
    def gradient(self, a: Any, stride: Any = ...) -> Any: ...
    def gradient_res(self, input: NDArray[np.floating], reach: int, grad: NDArray[np.floating], theta: NDArray[np.floating]) -> None: ...
