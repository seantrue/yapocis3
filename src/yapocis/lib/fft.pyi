from numpy.typing import NDArray
import numpy as np

class Fft:
    def fft1d(self, input: NDArray[np.complexfloating], direction: int) -> NDArray[np.complexfloating]: ...
    def fft1d_batch(self, input: NDArray[np.complexfloating], batch_size: int, fft_size: int, direction: int) -> NDArray[np.complexfloating]: ...
    def window(self, input: NDArray[np.floating], window_type: int) -> NDArray[np.floating]: ...
    def power_spectrum(self, fft_output: NDArray[np.complexfloating]) -> NDArray[np.floating]: ...
    def fft1d_res(self, input: NDArray[np.complexfloating], output: NDArray[np.complexfloating], direction: int) -> None: ...
    def window_res(self, input: NDArray[np.floating], window_type: int, output: NDArray[np.floating]) -> None: ...
    def power_spectrum_res(self, fft_output: NDArray[np.complexfloating], power: NDArray[np.floating]) -> None: ...
