from typing import Any
from numpy.typing import NDArray
import numpy as np

class FFT:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def write(self, a: Any, wait: Any = ...) -> Any: ...
    def read(self, a: Any) -> Any: ...
    def snapshot(self, **kwargs: Any) -> Any: ...
    def purge(self) -> Any: ...
    def forward(self, signal: Any) -> Any: ...
    def inverse(self, fft_result: Any) -> Any: ...
    def batch_forward(self, signals: Any) -> Any: ...
    def batch_inverse(self, fft_results: Any) -> Any: ...
    def apply_window(self, signal: Any, window_type: Any = ...) -> Any: ...
    def compute_power_spectrum(self, fft_result: Any) -> Any: ...
    def analyze_signal(self, signal: Any, sample_rate: Any = ..., window_type: Any = ..., return_db: Any = ..., positive_only: Any = ...) -> Any: ...
    def find_peaks(self, signal: Any, sample_rate: Any = ..., n_peaks: Any = ..., window_type: Any = ...) -> Any: ...
    def spectrogram(self, signal: Any, sample_rate: Any = ..., window_size: Any = ..., hop_size: Any = ..., window_type: Any = ..., return_db: Any = ...) -> Any: ...
    def estimate_frequency(self, signal: Any, sample_rate: Any = ..., window_type: Any = ...) -> Any: ...
    def bandpass_filter(self, signal: Any, low_freq: Any, high_freq: Any, sample_rate: Any = ...) -> Any: ...
    def coherence(self, signal1: Any, signal2: Any, window_type: Any = ...) -> Any: ...
    def energy(self, signal: Any) -> Any: ...
    def rms(self, signal: Any) -> Any: ...
    def snr(self, signal: Any, noise: Any) -> Any: ...
    def fft1d(self, input: NDArray[np.complexfloating], direction: int) -> NDArray[np.complexfloating]: ...
    def fft1d_batch(self, input: NDArray[np.complexfloating], batch_size: int, fft_size: int, direction: int) -> NDArray[np.complexfloating]: ...
    def window(self, input: NDArray[np.floating], window_type: int) -> NDArray[np.floating]: ...
    def power_spectrum(self, fft_output: NDArray[np.complexfloating]) -> NDArray[np.floating]: ...
    def fft1d_res(self, input: NDArray[np.complexfloating], output: NDArray[np.complexfloating], direction: int) -> None: ...
    def window_res(self, input: NDArray[np.floating], window_type: int, output: NDArray[np.floating]) -> None: ...
    def power_spectrum_res(self, fft_output: NDArray[np.complexfloating], power: NDArray[np.floating]) -> None: ...
