from typing import Any
from numpy.typing import NDArray
import numpy as np

class HSI:
    def __init__(self, device_name: Any = ..., backend: Any = ..., use_async: Any = ..., async_write: Any = ..., **kwargs: Any) -> None: ...
    def write(self, a: Any, wait: Any = ...) -> Any: ...
    def read(self, a: Any) -> Any: ...
    def snapshot(self, **kwargs: Any) -> Any: ...
    def purge(self) -> Any: ...
    def rgb2hsi3(self, rgb: Any) -> Any: ...
    def hsi2rgb3(self, hsi: Any) -> Any: ...
    def rgb2hsi(self, r: NDArray[np.floating], g: NDArray[np.floating], b: NDArray[np.floating]) -> tuple[NDArray[np.floating], NDArray[np.floating], NDArray[np.floating]]: ...
    def hsi2rgb(self, h: NDArray[np.floating], s: NDArray[np.floating], i: NDArray[np.floating]) -> tuple[NDArray[np.floating], NDArray[np.floating], NDArray[np.floating]]: ...
