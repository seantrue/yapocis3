from typing import Any
from numpy.typing import NDArray
import numpy as np

class TrueTrace:
    def __init__(self, device_name: Any = ..., backend: Any = ..., use_async: Any = ..., async_write: Any = ..., **kwargs: Any) -> None: ...
    def write(self, a: Any, wait: Any = ...) -> Any: ...
    def read(self, a: Any) -> Any: ...
    def snapshot(self, **kwargs: Any) -> Any: ...
    def purge(self) -> Any: ...
    def trace_segments(self, mask_u8: Any, iso: Any = ...) -> Any: ...
    def init_seed_from_mask(self, mask: NDArray[np.signedinteger]) -> tuple[NDArray[np.floating], NDArray[np.floating]]: ...
    def jfa_step(self, jump: int, seed_in: NDArray[np.floating], dist: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def marching_squares(self, dist: NDArray[np.floating], iso: float, seg_counter: NDArray[np.unsignedinteger]) -> NDArray[np.floating]: ...
