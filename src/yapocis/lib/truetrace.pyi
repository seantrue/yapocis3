from numpy.typing import NDArray
import numpy as np

class Truetrace:
    def init_seed_from_mask(self, mask: NDArray[np.signedinteger]) -> tuple[NDArray[np.floating], NDArray[np.floating]]: ...
    def jfa_step(self, jump: int, seed_in: NDArray[np.floating], dist: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def marching_squares(self, dist: NDArray[np.floating], iso: float, seg_counter: NDArray  # uint32) -> NDArray[np.floating]: ...
