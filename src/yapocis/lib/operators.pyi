from numpy.typing import NDArray
import numpy as np

class Operators:
    def add(self, input1: NDArray[np.floating], input2: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def sub(self, input1: NDArray[np.floating], input2: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def mul(self, input1: NDArray[np.floating], input2: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def divop(self, input1: NDArray[np.floating], input2: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def div(self, input1: NDArray[np.floating], input2: NDArray[np.floating]) -> NDArray[np.floating]: ...
    def div_res(self, input1: NDArray[np.floating], input2: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def add_res(self, input1: NDArray[np.floating], input2: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def sub_res(self, input1: NDArray[np.floating], input2: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def mul_res(self, input1: NDArray[np.floating], input2: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
    def divop_res(self, input1: NDArray[np.floating], input2: NDArray[np.floating], output: NDArray[np.floating]) -> None: ...
