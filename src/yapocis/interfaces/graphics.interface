interface graphics {
    # Kernels have aliases for running on resident buffers
    kernel lines(width_of a, height_of a, inout float a, width_of lines, in float lines, in float distance, in float aa_width, in float rcolor);
    extension res of lines(width_of a, height_of a, resident float a, width_of lines, in float lines, in float distance, in float aa_width, in float rcolor);
    kernel rects(width_of a, height_of a, inout float a, width_of lines, in float lines, in float aa_width, in float rcolor);
    extension res of rects(width_of a, height_of a, resident float a, width_of lines, in float lines, in float aa_width, in float rcolor);
    kernel circles(width_of a, height_of a, inout float a, width_of lines, in float lines, in float aa_width, in float rcolor);
    extension res of circles(width_of a, height_of a, resident float a, width_of lines, in float lines, in float aa_width, in float rcolor);
    kernel triangles(width_of a, height_of a, inout float a, width_of lines, in float lines, in float aa_width, in float rcolor);
    extension res of triangles(width_of a, height_of a, resident float a, width_of lines, in float lines, in float aa_width, in float rcolor);
    kernel ellipses(width_of a, height_of a, inout float a, width_of lines, in float lines, in float aa_width, in float rcolor);
    extension res of ellipses(width_of a, height_of a, resident float a, width_of lines, in float lines, in float aa_width, in float rcolor);
    kernel composite(width_of a, height_of a, inout float a, width_of lines, in int lines, in float pixels, in int ipixels,  width_of pixels);
    extension res of composite(width_of a, height_of a, resident float a, width_of lines, in int lines, in float pixels, in int ipixels,  width_of pixels);
};
