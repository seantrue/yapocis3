interface graphics4 {
    # Kernels have aliases for running on resident buffers
    kernel lines(width_of a, height_of a, inout float a, width_of lines, in float lines, float distance, in float rcolor);
    alias lines_in as lines(width_of a, height_of a, resident float a, width_of lines, in float lines, float distance, in float rcolor);
    kernel rects(width_of a, height_of a, inout float a, width_of lines, in float lines, in float rcolor);
    alias rects_in as rects(width_of a, height_of a, resident float a, width_of lines, in float lines, in float rcolor);
    kernel circles(width_of a, height_of a, inout float a, width_of lines, in float lines, in float rcolor);
    alias circles_in as circles(width_of a, height_of a, resident float a, width_of lines, in float lines, in float rcolor);
    kernel triangles(width_of a, height_of a, inout float a, width_of lines, in float lines, in float rcolor);
    alias triangles_in as triangles(width_of a, height_of a, resident float a, width_of lines, in float lines, in float rcolor);
    kernel ellipses(width_of a, height_of a, inout float a, width_of lines, in float lines, in float rcolor);
    alias ellipses_in as ellipses(width_of a, height_of a, resident float a, width_of lines, in float lines, in float rcolor);
    kernel composite(width_of a, height_of a, inout float a, width_of lines, in int lines, in float pixels, in int ipixels,  width_of pixels);
    alias composite_in as composite(width_of a, height_of a, resident float a, width_of lines, in int lines, in float pixels, in int ipixels,  width_of pixels);
};
